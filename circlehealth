<script>
  let activeCard = 'Visa';

  function selectChip(el, name) {
    document.querySelectorAll('.chip').forEach(c => c.classList.remove('active'));
    el.classList.add('active');
    activeCard = name;
  }

  function formatCard(input) {
    let v = input.value.replace(/\D/g, '').slice(0, 16);
    let out = [];
    for (let i = 0; i < v.length; i += 4) out.push(v.slice(i, i + 4));
    input.value = out.join('  ');
    // clear error while still typing
    setCard('neutral');
  }

  function validateCard(input) {
    const digits = input.value.replace(/\s/g, '');
    if (digits.length === 16) { setCard('valid'); return true; }
    if (digits.length > 0)    { setCard('error'); return false; }
    setCard('neutral'); return false;
  }

  function setCard(state) {
    const inp  = document.getElementById('cardNumber');
    const icon = document.getElementById('cardStatus');
    const err  = document.getElementById('cardError');
    inp.classList.remove('is-error', 'is-valid');
    icon.classList.remove('show');
    icon.innerHTML = '';
    err.classList.remove('show');
    if (state === 'error') {
      inp.classList.add('is-error');
      icon.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D0021B" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
      icon.classList.add('show');
      err.classList.add('show');
    } else if (state === 'valid') {
      inp.classList.add('is-valid');
      icon.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#107D54" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>`;
      icon.classList.add('show');
    }
  }

  function formatExpiry(input) {
    let v = input.value.replace(/\D/g, '');
    if (v.length >= 3) v = v.slice(0, 2) + ' / ' + v.slice(2, 4);
    else if (v.length === 2 && !input.value.includes('/')) v += ' / ';
    input.value = v;
    setExpiry('neutral');
  }

  function validateExpiry(input) {
    const raw = input.value.replace(/\s/g, '');
    const parts = raw.split('/');
    if (parts.length !== 2) { setExpiry('error'); return false; }
    const mm = parseInt(parts[0], 10);
    const yy = parseInt(parts[1], 10);
    if (isNaN(mm) || isNaN(yy) || mm < 1 || mm > 12) { setExpiry('error'); return false; }
    const now = new Date();
    const cy = now.getFullYear() % 100;
    const cm = now.getMonth() + 1;
    if (yy < cy || (yy === cy && mm < cm)) { setExpiry('error'); return false; }
    setExpiry('valid');
    return true;
  }

  function setExpiry(state) {
    const inp  = document.getElementById('expiry');
    const icon = document.getElementById('expiryStatus');
    const err  = document.getElementById('expiryError');
    inp.classList.remove('is-error', 'is-valid');
    icon.classList.remove('show');
    icon.innerHTML = '';
    err.classList.remove('show');
    if (state === 'error') {
      inp.classList.add('is-error');
      icon.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#D0021B" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><line x1="15" y1="9" x2="9" y2="15"/><line x1="9" y1="9" x2="15" y2="15"/></svg>`;
      icon.classList.add('show');
      err.classList.add('show');
    } else if (state === 'valid') {
      inp.classList.add('is-valid');
      icon.innerHTML = `<svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="#107D54" stroke-width="2.5" stroke-linecap="round"><circle cx="12" cy="12" r="10"/><polyline points="9 12 11 14 15 10"/></svg>`;
      icon.classList.add('show');
    }
  }

  function handlePay() {
    const name     = document.getElementById('cardName').value.trim();
    const number   = document.getElementById('cardNumber').value.replace(/\s/g, '');
    const expValid = validateExpiry(document.getElementById('expiry'));
    const cvv      = document.getElementById('cvv').value.trim();
    const postcode = document.getElementById('postcode').value.trim();

    const cardValid = validateCard(document.getElementById('cardNumber'));
    if (!name || !cardValid || !expValid || cvv.length < 3 || !postcode) {
      const btn = document.getElementById('payBtn');
      btn.classList.remove('shake');
      void btn.offsetWidth;
      btn.classList.add('shake');
      btn.addEventListener('animationend', () => btn.classList.remove('shake'), { once: true });
      return;
    }

    const now = new Date();
    document.getElementById('rcptDate').textContent =
      now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    document.getElementById('rcptTime').textContent =
      now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
    document.getElementById('rcptCardType').textContent = activeCard;
    document.getElementById('rcptLast4').textContent = '•••• ' + number.slice(-4);

    document.getElementById('paymentPage').classList.remove('active');
    document.getElementById('invoicePage').classList.add('active');
    window.scrollTo(0, 0);
  }

  function resetToPayment() {
    // Production: cognigy.closeXApp({ status: 'paid', ref: 'CHG-2024-08741' });
    document.getElementById('invoicePage').classList.remove('active');
    document.getElementById('paymentPage').classList.add('active');
    window.scrollTo(0, 0);
  }

  (function () {
    const now = new Date();
    document.getElementById('rcptDate').textContent =
      now.toLocaleDateString('en-GB', { day: 'numeric', month: 'long', year: 'numeric' });
    document.getElementById('rcptTime').textContent =
      now.toLocaleTimeString('en-GB', { hour: '2-digit', minute: '2-digit' });
  })();
</script>
