    <!-- Pay -->
    <button class="pay-btn" id="payBtn" onclick="handlePay()">
      <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2"><rect x="1" y="4" width="22" height="16" rx="2.5"/><line x1="1" y1="10" x2="23" y2="10"/></svg>
      Pay £550.00 Securely
    </button>

    <div class="security-note">
      <svg width="12" height="13" viewBox="0 0 12 14" fill="none" stroke="currentColor" stroke-width="1.4"><path d="M6 1L1 3v4c0 3.3 2.1 6.4 5 7.4C8.9 13.4 11 10.3 11 7V3L6 1z"/></svg>
      No card data stored · Protected by Circle Health Group
    </div>

