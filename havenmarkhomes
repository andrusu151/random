<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Havenmark Homes – Payment</title>
    <link href="https://fonts.googleapis.com/css2?family=DM+Serif+Display&family=DM+Sans:wght@400;500;600&display=swap" rel="stylesheet" />
    <script src="/sdk/app-page-sdk.js"></script>
 
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            -webkit-tap-highlight-color: transparent;
        }
 
        html { font-size: 16px; }
 
        body {
            font-family: 'DM Sans', sans-serif;
            background: linear-gradient(160deg, #fff7f4 0%, #ffe8e0 60%, #ffd6cc 100%);
            background-repeat: no-repeat;
            background-size: cover;
            background-attachment: scroll;
            min-height: 100vh;
            padding: 36px 16px 100px;
            display: flex;
            flex-direction: column;
            align-items: center;
        }
 
        /* ── Logo ── */
        .logo-wrap { margin-bottom: 20px; }
        .logo-wrap img { height: 44px; object-fit: contain; display: block; }
 
        /* ── Card Preview ── */
        .card-scene {
            width: 100%;
            max-width: 420px;
            height: 190px;
            perspective: 1000px;
            margin-bottom: 28px;
            flex-shrink: 0;
        }
        .card-inner {
            width: 100%;
            height: 100%;
            position: relative;
            transform-style: preserve-3d;
            transition: transform 0.5s ease;
        }
        .card-inner.flipped { transform: rotateY(180deg); }
        .card-face {
            position: absolute;
            inset: 0;
            border-radius: 16px;
            backface-visibility: hidden;
            -webkit-backface-visibility: hidden;
            overflow: hidden;
        }
        .card-front {
            background: linear-gradient(135deg, #e8794a, #c9402a);
            box-shadow: 0 10px 28px rgba(201,64,42,.45);
            padding: 20px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
        }
        .card-back {
            background: linear-gradient(135deg, #c9402a, #9e3020);
            box-shadow: 0 10px 28px rgba(201,64,42,.45);
            transform: rotateY(180deg);
        }
        .card-stripe { background: #1f2937; height: 42px; margin-top: 28px; }
        .card-cvv-area { padding: 10px 18px 0; }
        .card-cvv-label { color: rgba(255,255,255,.6); font-size: 10px; text-align: right; margin-bottom: 4px; }
        .card-cvv-box {
            background: #fff;
            border-radius: 6px;
            height: 34px;
            display: flex;
            align-items: center;
            justify-content: flex-end;
            padding: 0 14px;
        }
        .card-cvv-box span { font-family: monospace; font-size: 14px; letter-spacing: 4px; color: #1f2937; }
        .card-chip { width: 38px; height: 26px; background: rgba(255,255,255,.28); border-radius: 5px; }
        .card-brand { color: rgba(255,255,255,.7); font-size: 11px; font-weight: 600; letter-spacing: 2px; }
        .card-number { font-family: monospace; font-size: 16px; letter-spacing: 3px; color: #fff; margin-bottom: 10px; }
        .card-meta-row { display: flex; justify-content: space-between; align-items: flex-end; }
        .card-meta-label { font-size: 9px; color: rgba(255,255,255,.55); margin-bottom: 2px; letter-spacing: 0.5px; text-transform: uppercase; }
        .card-meta-value { font-size: 12px; font-weight: 600; color: #fff; letter-spacing: 1px; }
 
        /* ── Form Card ── */
        .form-card {
            width: 100%;
            max-width: 420px;
            background: rgba(255,255,255,0.9);
            border-radius: 22px;
            padding: 26px 22px 30px;
            box-shadow: 0 6px 32px rgba(201,64,42,.13);
        }
        .form-title {
            font-family: 'DM Serif Display', serif;
            font-size: 21px;
            color: #3d1a0e;
            text-align: center;
            margin-bottom: 22px;
        }
 
        /* ── Fields ── */
        .field { margin-bottom: 14px; position: relative; }
        .field label {
            display: block;
            font-size: 12px;
            font-weight: 600;
            color: #b24a2a;
            margin-bottom: 5px;
            letter-spacing: 0.4px;
        }
        .field-wrap { position: relative; display: flex; align-items: center; }
        .field input {
            display: block;
            width: 100%;
            padding: 14px 42px 14px 15px;
            font-size: 16px;
            font-family: 'DM Sans', sans-serif;
            color: #3d1a0e;
            background: #fff;
            border: 1.5px solid #f0c0ae;
            border-radius: 12px;
            outline: none;
            -webkit-appearance: none;
            appearance: none;
            transition: border-color .18s, box-shadow .18s;
        }
        .field input:focus {
            border-color: #e05c3a;
            box-shadow: 0 0 0 3px rgba(224,92,58,.11);
        }
        .field input::placeholder { color: #d4a898; }
        .field input.input-invalid {
            border-color: #ef4444;
            box-shadow: 0 0 0 3px rgba(239,68,68,.1);
        }
        .row-2 { display: grid; grid-template-columns: 1fr 1fr; gap: 12px; }
 
        /* ── Validation Indicator ── */
        .indicator {
            position: absolute;
            right: 11px;
            top: 50%;
            transform: translateY(-50%);
            width: 20px;
            height: 20px;
            border-radius: 50%;
            display: none;
            align-items: center;
            justify-content: center;
            flex-shrink: 0;
            pointer-events: none;
        }
        .indicator.show { display: flex; }
        .indicator.valid { background: #22c55e; }
        .indicator.invalid { background: #ef4444; }
        .indicator svg { display: block; }
 
        /* ── Field error message ── */
        .field-msg {
            font-size: 11px;
            color: #ef4444;
            margin-top: 4px;
            display: none;
        }
        .field-msg.show { display: block; }
 
        /* ── Security note ── */
        .security-note {
            display: flex;
            align-items: center;
            gap: 7px;
            margin-bottom: 18px;
        }
        .security-note p { font-size: 11.5px; color: #b24a2a; }
        @keyframes pulse-lock {
            0%, 100% { opacity: 1; }
            50%       { opacity: .4; }
        }
        .lock-icon { flex-shrink: 0; animation: pulse-lock 2s ease-in-out infinite; }
 
        /* ── Submit button ── */
        .btn-submit {
            display: block;
            width: 100%;
            padding: 17px;
            font-family: 'DM Sans', sans-serif;
            font-size: 16px;
            font-weight: 600;
            color: #fff;
            background: linear-gradient(135deg, #e05c3a 0%, #c9402a 100%);
            border: none;
            border-radius: 13px;
            cursor: pointer;
            box-shadow: 0 5px 18px rgba(201,64,42,.38);
            -webkit-appearance: none;
            appearance: none;
            transition: transform .14s, box-shadow .14s;
            margin-bottom: 4px;
        }
        .btn-submit:active {
            transform: scale(.97);
            box-shadow: 0 2px 8px rgba(201,64,42,.28);
        }
 
        /* ── Success screen ── */
        #success-screen {
            display: none;
            flex-direction: column;
            align-items: center;
            text-align: center;
            padding: 20px 24px 40px;
            width: 100%;
            max-width: 420px;
        }
        .tick-circle {
            width: 84px;
            height: 84px;
            border-radius: 50%;
            background: linear-gradient(135deg, #e05c3a, #c9402a);
            display: flex;
            align-items: center;
            justify-content: center;
            box-shadow: 0 8px 26px rgba(201,64,42,.42);
            margin-bottom: 22px;
            animation: pop 0.45s cubic-bezier(.175,.885,.32,1.275) both;
        }
        @keyframes pop {
            from { transform: scale(0); opacity: 0; }
            to   { transform: scale(1); opacity: 1; }
        }
        .success-heading { font-family: 'DM Serif Display', serif; font-size: 27px; color: #3d1a0e; margin-bottom: 10px; }
        .success-body { font-size: 14.5px; color: #7a3f26; line-height: 1.65; margin-bottom: 26px; }
        .success-ref-box {
            background: #fff0eb;
            border: 1.5px solid #f0c0ae;
            border-radius: 11px;
            padding: 12px 22px;
            font-size: 13px;
            color: #b24a2a;
            letter-spacing: 0.5px;
        }
        .success-ref-box strong { color: #c9402a; }
    </style>
</head>
 
<body>
 
    <!-- ── Logo ── -->
    <div class="logo-wrap" id="el-logo">
        <img
            src="data:image/svg+xml;base64,"
            alt="Havenmark Homes"
        />
    </div>
 
    <!-- ── Card Preview ── -->
    <div class="card-scene" id="el-card">
        <div class="card-inner" id="card-inner">
            <div class="card-face card-front">
                <div style="position:absolute;inset:0;opacity:.07;background-image:repeating-linear-gradient(45deg,#fff 0,#fff 1px,transparent 0,transparent 50%);background-size:18px 18px;"></div>
                <div style="position:relative;display:flex;justify-content:space-between;align-items:flex-start;">
                    <div class="card-chip"></div>
                    <span class="card-brand">HAVENMARK</span>
                </div>
                <div style="position:relative;">
                    <div class="card-number" id="prev-num">•••• •••• •••• ••••</div>
                    <div class="card-meta-row">
                        <div>
                            <div class="card-meta-label">Card Holder</div>
                            <div class="card-meta-value" id="prev-name">YOUR NAME</div>
                        </div>
                        <div style="text-align:right;">
                            <div class="card-meta-label">Expires</div>
                            <div class="card-meta-value" id="prev-exp">MM/YY</div>
                        </div>
                    </div>
                </div>
            </div>
            <div class="card-face card-back">
                <div class="card-stripe"></div>
                <div class="card-cvv-area">
                    <div class="card-cvv-label">CVV</div>
                    <div class="card-cvv-box"><span>•••</span></div>
                </div>
            </div>
        </div>
    </div>
 
    <!-- ── Form ── -->
    <div class="form-card" id="el-form">
        <div class="form-title">Payment Details</div>
 
        <form id="payment-form" novalidate>
 
            <div class="row-2">
                <div class="field">
                    <label for="firstName">First Name</label>
                    <div class="field-wrap">
                        <input type="text" id="firstName" name="firstName" placeholder="John" autocomplete="given-name" required />
                        <span class="indicator" id="ind-firstName">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                <polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </div>
                <div class="field">
                    <label for="lastName">Last Name</label>
                    <div class="field-wrap">
                        <input type="text" id="lastName" name="lastName" placeholder="Doe" autocomplete="family-name" required />
                        <span class="indicator" id="ind-lastName">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                <polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </div>
            </div>
 
            <div class="field">
                <label for="email">Email Address</label>
                <div class="field-wrap">
                    <input type="email" id="email" name="email" placeholder="john.doe@example.com" autocomplete="email" inputmode="email" required />
                    <span class="indicator" id="ind-email">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
            </div>
 
            <div class="field">
                <label for="cardNumber">Card Number</label>
                <div class="field-wrap">
                    <input type="text" id="cardNumber" name="cardNumber" placeholder="1234 5678 9012 3456" inputmode="numeric" autocomplete="cc-number" maxlength="19" required />
                    <span class="indicator" id="ind-cardNumber">
                        <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                            <polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                        </svg>
                    </span>
                </div>
            </div>
 
            <div class="row-2">
                <div class="field">
                    <label for="expiry">Expiry Date</label>
                    <div class="field-wrap">
                        <input type="text" id="expiry" name="expiry" placeholder="MM/YY" inputmode="numeric" autocomplete="cc-exp" maxlength="5" required />
                        <span class="indicator" id="ind-expiry"></span>
                    </div>
                    <div class="field-msg" id="msg-expiry">Card has expired</div>
                </div>
                <div class="field">
                    <label for="cvv">CVV</label>
                    <div class="field-wrap">
                        <input type="text" id="cvv" name="cvv" placeholder="123" inputmode="numeric" autocomplete="cc-csc" maxlength="4" required />
                        <span class="indicator" id="ind-cvv">
                            <svg width="10" height="10" viewBox="0 0 10 10" fill="none">
                                <polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/>
                            </svg>
                        </span>
                    </div>
                </div>
            </div>
 
            <div class="security-note">
                <svg class="lock-icon" width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="#b24a2a" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
                    <rect x="3" y="11" width="18" height="11" rx="2"/>
                    <path d="M7 11V7a5 5 0 0 1 10 0v4"/>
                </svg>
                <p>Your payment is encrypted and secure</p>
            </div>
 
            <button type="submit" class="btn-submit">Submit Payment</button>
 
        </form>
    </div>
 

 
    <script>
        const TICK_SVG = `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><polyline points="1.5,5 4,7.5 8.5,2.5" stroke="#fff" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round"/></svg>`;
        const CROSS_SVG = `<svg width="10" height="10" viewBox="0 0 10 10" fill="none"><line x1="2" y1="2" x2="8" y2="8" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/><line x1="8" y1="2" x2="2" y2="8" stroke="#fff" stroke-width="1.6" stroke-linecap="round"/></svg>`;
 
        function setIndicator(id, state) {
            const el = document.getElementById('ind-' + id);
            if (!el) return;
            el.className = 'indicator';
            if (state === 'valid') {
                el.classList.add('show', 'valid');
                el.innerHTML = TICK_SVG;
            } else if (state === 'invalid') {
                el.classList.add('show', 'invalid');
                el.innerHTML = CROSS_SVG;
            }
        }
 
        function isExpired(val) {
            const m = val.match(/^(\d{2})\/(\d{2})$/);
            if (!m) return false;
            const month = parseInt(m[1], 10);
            const year = 2000 + parseInt(m[2], 10);
            const now = new Date();
            const expDate = new Date(year, month, 1);
            return expDate <= new Date(now.getFullYear(), now.getMonth(), 1);
        }
 
        function formatCard(e) {
            let v = e.target.value.replace(/\D/g, '').slice(0, 16);
            e.target.value = v.replace(/(.{4})/g, '$1 ').trim();
            validateCardNumber();
            updatePreview();
        }
 
        function formatExpiry(e) {
            let v = e.target.value.replace(/\D/g, '').slice(0, 4);
            if (v.length >= 3) v = v.slice(0, 2) + '/' + v.slice(2);
            e.target.value = v;
            validateExpiry();
            updatePreview();
        }
 
        function validateText(id) {
            const val = document.getElementById(id).value.trim();
            setIndicator(id, val.length > 0 ? 'valid' : '');
            updatePreview();
        }
 
        function validateEmail() {
            const val = document.getElementById('email').value.trim();
            const ok = /^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(val);
            setIndicator('email', val.length > 0 ? (ok ? 'valid' : '') : '');
        }
 
        function validateCardNumber() {
            const raw = document.getElementById('cardNumber').value.replace(/\s/g, '');
            setIndicator('cardNumber', raw.length === 16 ? 'valid' : '');
        }
 
        function validateCvv() {
            const val = document.getElementById('cvv').value;
            setIndicator('cvv', val.length >= 3 ? 'valid' : '');
        }
 
        function validateExpiry() {
            const val = document.getElementById('expiry').value;
            const msg = document.getElementById('msg-expiry');
            const inp = document.getElementById('expiry');
 
            if (val.length === 5) {
                const m = val.match(/^(\d{2})\/(\d{2})$/);
                if (m && parseInt(m[1], 10) >= 1 && parseInt(m[1], 10) <= 12) {
                    if (isExpired(val)) {
                        setIndicator('expiry', 'invalid');
                        msg.classList.add('show');
                        inp.classList.add('input-invalid');
                    } else {
                        setIndicator('expiry', 'valid');
                        msg.classList.remove('show');
                        inp.classList.remove('input-invalid');
                    }
                }
            } else {
                setIndicator('expiry', '');
                msg.classList.remove('show');
                inp.classList.remove('input-invalid');
            }
        }
 
        function updatePreview() {
            const num  = document.getElementById('cardNumber').value || '•••• •••• •••• ••••';
            const exp  = document.getElementById('expiry').value || 'MM/YY';
            const fn   = document.getElementById('firstName').value;
            const ln   = document.getElementById('lastName').value;
            const name = (fn + ' ' + ln).trim() || 'YOUR NAME';
            document.getElementById('prev-num').textContent  = num;
            document.getElementById('prev-exp').textContent  = exp;
            document.getElementById('prev-name').textContent = name.toUpperCase();
        }
 
        function generateRef() {
            const chars = 'ABCDEFGHJKLMNPQRSTUVWXYZ23456789';
            let code = '';
            for (let i = 0; i < 6; i++) code += chars[Math.floor(Math.random() * chars.length)];
            return 'HM-' + code;
        }
 
        document.getElementById('firstName').addEventListener('input', () => validateText('firstName'));
        document.getElementById('lastName').addEventListener('input', () => validateText('lastName'));
        document.getElementById('email').addEventListener('input', validateEmail);
        document.getElementById('cardNumber').addEventListener('input', formatCard);
        document.getElementById('expiry').addEventListener('input', formatExpiry);
        document.getElementById('cvv').addEventListener('input', validateCvv);
        document.getElementById('cvv').addEventListener('focus',  () => document.getElementById('card-inner').classList.add('flipped'));
        document.getElementById('cvv').addEventListener('blur',   () => document.getElementById('card-inner').classList.remove('flipped'));
 
        document.getElementById('payment-form').addEventListener('submit', function(e) {
            e.preventDefault();
            e.stopPropagation();
 
            const form   = e.target;
            const data   = new FormData(form);
            const values = {};
            data.forEach((v, k) => values[k] = v);
 
            const name = ((values.firstName || '') + ' ' + (values.lastName || '')).trim();
 
            document.getElementById('el-logo').style.display  = 'none';
            document.getElementById('el-card').style.display  = 'none';
            document.getElementById('el-form').style.display  = 'none';
 
            document.getElementById('success-name').textContent = name;
            document.getElementById('success-ref').textContent  = generateRef();
            const s = document.getElementById('success-screen');
            s.style.display = 'flex';
 
            window.scrollTo(0, 0);
 
            if (typeof SDK !== 'undefined') SDK.submit(values);
        });
    </script>
 
</body>
</html>
